# Copie para ash_aurora.env (mesma pasta do ash_aurora.sh) e ajuste.
# A conexao com o banco continua vindo do backup_env_aurora.sh.

# Rotulo dos arquivos (ex.: o nome da instancia ou do cluster)
INSTANCIA="aurora-prod"

# Uma amostra a cada N segundos. 15 s da uma boa resolucao; 30 s reduz o volume pela metade.
INTERVALO=15

# 1 = guarda tambem as sessoes que terminaram uma SQL desde a ultima amostra.
# Melhora a contagem de execucoes curtas, mas com pool de conexoes grande multiplica o volume.
INCLUIR_FINALIZADAS=0

# Quantos dias de arquivos ficam no servidor
RETENCAO_DIAS=10

# --- Logs do Aurora (subcomando "logs") ----------------------------------------
# Identificador da INSTANCIA no RDS (nao do cluster), ex.: aurora-prod-instance-1
RDS_INSTANCIA=""
AWS_REGION="sa-east-1"

# --- Email (subcomando "enviar") -----------------------------------------------
MAIL_PARA="voce@empresa.com.br"
MAIL_DE="ash-aurora@empresa.com.br"
# sendmail: usa /usr/sbin/sendmail (ex.: msmtp-mta apontando para um SMTP na porta 587)
# ses:      usa "aws ses send-raw-email" (remetente verificado no SES + permissao ses:SendRawEmail)
MAIL_METODO="sendmail"
# Acima disso os arquivos nao vao anexados: sobem para o S3 (se configurado) ou ficam no servidor
MAX_ANEXO_MB=15
# S3_DESTINO="s3://meu-bucket/ash-aurora"
